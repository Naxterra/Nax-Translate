<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <RootNamespace>NaxTranslate</RootNamespace>
    <AssemblyName>Nax-Translate</AssemblyName>
    <Product>Nax-Translate</Product>
    <Description>Desktop translator for Windows with DeepL Pro, Claude and ChatGPT</Description>
    <Version>1.4.0</Version>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives below the repository root and must not be compiled into the app. -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
    <!-- The icon tool is a separate program and must not be compiled into the app either. -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Page Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nax-Translate.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <Resource Include="logo.png" />
    <Content Include="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
